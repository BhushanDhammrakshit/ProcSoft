PORT=3000

# Option A: hosted Postgres (e.g. Neon) - takes priority over DB_* below if set
# Get this from your Neon dashboard (Connection Details -> "Pooled connection" string).
# Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-12345.region.aws.neon.tech/neondb?sslmode=require

# Option B: local Postgres (used only if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=procsoft
DB_PASSWORD=procsoft
DB_NAME=procsoft

# SMTP for bulk mailing
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ProcSoft <no-reply@procsoft.local>"

# AI (optional - AI features degrade gracefully if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Automated supplier discovery (optional - no paid B2B providers used).
# Tiered priority chain, queried in order until enough results are found. Each endpoint
# must accept ?q=<query> and return { "suppliers": [{ legalName, email, phone, city, state,
# website, gstin }] }. Priority 2 (previously-discovered suppliers) is internal/automatic
# and needs no config - it uses embeddings stored on existing supplier records.
# Tier 1 - Licensed APIs you have access to. No free/universal option exists - point this at
# your own adapter around a provider you've chosen and subscribed to (e.g. Kompass, IndiaMART
# Business API, Dun & Bradstreet), reshaped to the {suppliers:[...]} contract above.
EXTERNAL_LICENSED_API_URL=
# Tier 3 - Government / open data sources (e.g. data.gov.in). Each dataset has its own schema
# and resource ID, so point this at your own adapter that queries the dataset you pick and
# reshapes its response to the {suppliers:[...]} contract above.
EXTERNAL_OPEN_DATA_URL=
# Tier 4 - Official supplier websites / directories (generic {suppliers:[...]} contract).
# Only used if neither SERPER_API_KEY nor BRAVE_SEARCH_API_KEY below is set.
EXTERNAL_OFFICIAL_SITES_URL=
# Legacy single-endpoint var, still honored as Tier 4 if EXTERNAL_OFFICIAL_SITES_URL is unset.
EXTERNAL_SUPPLIER_SEARCH_URL=

# Tier 4 native option (preferred): Serper.dev (https://google.serper.dev/search) - Google-
# results-backed SERP API, 2,500 free queries, no credit card required. Get a key at
# https://serper.dev. Used ahead of Brave below if both are set.
SERPER_API_KEY=

# Tier 4 native option (fallback): Brave Search API (https://api.search.brave.com/res/v1/web/search).
# Requires a credit card for its small monthly free credit. Get a key at
# https://api-dashboard.search.brave.com/register. Both this and Serper.dev results have no
# contact email, so a placeholder is synthesized; verify contact details manually before outreach.
BRAVE_SEARCH_API_KEY=

# Configurable qualification thresholds for AI supplier search (overridable per-request).
SUPPLIER_SEARCH_TARGET_COUNT=10
SUPPLIER_SEARCH_MIN_SCORE=70

# Optional embeddings model for semantic re-matching of previously-discovered suppliers
# (falls back to a local hashing-based embedding when OPENAI_API_KEY is unset).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
